{
  "manifest_version": 3,
  "name": "FBCLID Cleaner",
  "version": "0.2.0",
  "description": "Removes Facebook-related tracking parameters and offers an optional strict privacy mode.",
  "minimum_chrome_version": "102",
  "permissions": ["declarativeNetRequest", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_safe",
        "enabled": true,
        "path": "rules-safe.json"
      },
      {
        "id": "ruleset_strict",
        "enabled": false,
        "path": "rules-strict.json"
      }
    ]
  },
  "action": {
    "default_title": "FBCLID Cleaner",
    "default_popup": "popup.html"
  }
}
